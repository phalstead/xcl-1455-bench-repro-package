+#[test]
+fn gpu_scalar_loop_and_scc_timing_batch() {
+    if !gpu_ready() { return; }
+    let code = prog(&[
+        ("S_MOV_B32", "ENC_SOP1", &[("SDST", 0), ("SSRC0", 128)], None),
+        ("S_MOV_B32", "ENC_SOP1", &[("SDST", 1), ("SSRC0", 138)], None),
+        ("S_ADD_U32", "ENC_SOP2", &[("SDST", 0), ("SSRC0", 0), ("SSRC1", 1)], None),
+        ("S_SUB_U32", "ENC_SOP2", &[("SDST", 1), ("SSRC0", 1), ("SSRC1", 129)], None),
+        ("S_CMP_LG_U32", "ENC_SOPC", &[("SSRC0", 1), ("SSRC1", 128)], None),
+        ("S_CBRANCH_SCC1", "ENC_SOPP", &[("SIMM16", 0xFFFC)], None),
+        ("V_MOV_B32", "ENC_VOP1", &[("VDST", 1), ("SRC0", 0)], None),
+    ]);
+    let st = KernelState::default();
+    let t0 = std::time::Instant::now();
+    let tr = super::translate(&code, &runner::options(super::Mode::Kernel)).unwrap();
+    let t_translate = t0.elapsed().as_secs_f64() * 1000.0;
+    assert!(tr.complete(), "unsupported: {:?}", tr.unsupported);
+    let t1 = std::time::Instant::now();
+    let dxil = super::dxc::compile(&tr.hlsl, "main", "cs_6_6", &[]).unwrap();
+    let t_compile = t1.elapsed().as_secs_f64() * 1000.0;
+    let _ = runner::run(&dxil, &st, &[]).unwrap(); // warmup
+    let batches = [1usize, 100, 1000, 10000];
+    let trials = 30usize;
+    println!("XCL_BATCH_JSON_BEGIN");
+    println!("{{\"translateMs\":{t_translate},\"compileMs\":{t_compile},\"trials\":{trials},\"batches\":[");
+    for (bi, &b) in batches.iter().enumerate() {
+        let (r, ms, hz) = runner::run_timed_batch(&dxil, &st, &[], b, trials).unwrap();
+        assert_eq!(r.sgpr[0], 55, "s0 batch {b}");
+        assert!(r.vgpr.iter().all(|v| v[1] == 55), "v1 batch {b}");
+        let mut v = ms.clone();
+        v.sort_by(|a,b| a.partial_cmp(b).unwrap());
+        let med=v[v.len()/2]; let p95=v[((v.len() as f64*0.95) as usize).min(v.len()-1)];
+        let min=*v.first().unwrap(); let max=*v.last().unwrap();
+        let mean=v.iter().sum::<f64>()/v.len() as f64;
+        let per_med=med/(b as f64); let per_p95=p95/(b as f64); let per_mean=mean/(b as f64);
+        let comma = if bi+1<batches.len() { "," } else { "" };
+        println!("  {{\"batch\":{b},\"tsFreqHz\":{hz},\"batchMsMedian\":{med},\"batchMsP95\":{p95},\"batchMsMin\":{min},\"batchMsMax\":{max},\"batchMsMean\":{mean},\"perDispatchMsMedian\":{per_med},\"perDispatchMsP95\":{per_p95},\"perDispatchMsMean\":{per_mean},\"rawBatchMs\":{:?}}}{comma}", ms);
+    }
+    println!("]}}");
+    println!("XCL_BATCH_JSON_END");
+}
