+static BatchRun RunInterpBatch(Gpu& g, ID3D12PipelineState* pso, const std::vector<uint32_t>& prog, const std::vector<uint32_t>& init, const std::vector<uint32_t>& memIn, const RunCfg& cfg, int batch){
+    BatchRun R{}; batch = std::max(1,batch);
+    size_t progBytes=std::max<size_t>(prog.size()*4,16); size_t stateBytes=std::max<size_t>(init.size()*4,16); size_t outBytes=STATE_OUT_DWORDS*4; size_t memBytes=std::max<size_t>(cfg.memWords*4,256);
+    auto progBuf=MakeBuf(g.device.Get(),progBytes,D3D12_HEAP_TYPE_DEFAULT,D3D12_RESOURCE_STATE_COPY_DEST);
+    auto initBuf=MakeBuf(g.device.Get(),stateBytes,D3D12_HEAP_TYPE_DEFAULT,D3D12_RESOURCE_STATE_COPY_DEST);
+    auto outBuf=MakeBuf(g.device.Get(),outBytes,D3D12_HEAP_TYPE_DEFAULT,D3D12_RESOURCE_STATE_UNORDERED_ACCESS,D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS);
+    auto memBuf=MakeBuf(g.device.Get(),memBytes,D3D12_HEAP_TYPE_DEFAULT,D3D12_RESOURCE_STATE_COPY_DEST,D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS);
+    auto cbBuf=MakeBuf(g.device.Get(),256,D3D12_HEAP_TYPE_UPLOAD,D3D12_RESOURCE_STATE_GENERIC_READ);
+    if(!prog.empty()) Upload(g,progBuf.Get(),prog.data(),prog.size()*4,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE); else { uint32_t z=0; Upload(g,progBuf.Get(),&z,4,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE); }
+    Upload(g,initBuf.Get(),init.data(),init.size()*4,D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+    std::vector<uint32_t> memInit(cfg.memWords,0); for(size_t i=0;i<memIn.size()&&i<memInit.size();++i) memInit[i]=memIn[i];
+    Upload(g,memBuf.Get(),memInit.data(),memBytes,D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    struct CB{ uint32_t ProgWords,MaxSteps,WaveCount,MemWords; } cb{(uint32_t)prog.size(),cfg.maxSteps,cfg.waves,cfg.memWords};
+    void* m=nullptr; D3D12_RANGE zr{0,0}; Check(cbBuf->Map(0,&zr,&m),"MapCB"); memcpy(m,&cb,sizeof(cb)); cbBuf->Unmap(0,nullptr);
+    EnsureAlloc(g); Check(g.list->Reset(g.alloc.Get(),pso),"RL");
+    g.list->SetComputeRootSignature(g.rsInterp.Get());
+    g.list->SetComputeRootShaderResourceView(0,progBuf->GetGPUVirtualAddress());
+    g.list->SetComputeRootShaderResourceView(1,initBuf->GetGPUVirtualAddress());
+    g.list->SetComputeRootUnorderedAccessView(2,outBuf->GetGPUVirtualAddress());
+    g.list->SetComputeRootUnorderedAccessView(3,memBuf->GetGPUVirtualAddress());
+    g.list->SetComputeRootConstantBufferView(4,cbBuf->GetGPUVirtualAddress());
+    auto uav=[&](ID3D12Resource* r){ D3D12_RESOURCE_BARRIER b{}; b.Type=D3D12_RESOURCE_BARRIER_TYPE_UAV; b.UAV.pResource=r; g.list->ResourceBarrier(1,&b); };
+    g.list->EndQuery(g.tsHeap.Get(),D3D12_QUERY_TYPE_TIMESTAMP,0);
+    for(int i=0;i<batch;++i){ g.list->Dispatch(1,1,1); uav(outBuf.Get()); uav(memBuf.Get()); }
+    g.list->EndQuery(g.tsHeap.Get(),D3D12_QUERY_TYPE_TIMESTAMP,1);
+    g.list->ResolveQueryData(g.tsHeap.Get(),D3D12_QUERY_TYPE_TIMESTAMP,0,2,g.tsReadback.Get(),0);
+    Check(g.list->Close(),"CloseList");
+    auto t0=Clock::now(); ID3D12CommandList* ls[]={g.list.Get()}; g.queue->ExecuteCommandLists(1,ls); Wait(g); auto t1=Clock::now();
+    R.batchWallMs=Ms(t0,t1);
+    UINT64 ts[2]={}; void* tm=nullptr; D3D12_RANGE rr{0,sizeof(ts)}, rz{0,0}; if(SUCCEEDED(g.tsReadback->Map(0,&rr,&tm))){ memcpy(ts,tm,sizeof(ts)); g.tsReadback->Unmap(0,&rz); }
+    R.batchGpuMs=(g.tsFreq>0&&ts[1]>ts[0])?((double)(ts[1]-ts[0])*1000.0/(double)g.tsFreq):R.batchWallMs;
+    auto outState=Readback(g,outBuf.Get(),outBytes,D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+    rdna2::WaveState gs{}; ApplyOut(gs,outState,R.status,R.steps);
+    R.s0=gs.sgpr[0]; R.v1All55=true; for(int l=0;l<64;++l) if(rdna2::vgpr(gs,l,1)!=55u) R.v1All55=false;
+    R.ok=true; return R;
+}
