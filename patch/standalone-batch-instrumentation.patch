+static int RunXclCompareBatch(Gpu& g, const std::string& outDir, const std::vector<int>& batches, int trials){
+    MkdirP((outDir+"/xcl_compare_batch").c_str());
+    std::ofstream log(outDir+"/console.log", std::ios::app|std::ios::binary);
+    auto L=[&](const std::string& s){ std::cout<<s<<std::endl; log<<s<<std::endl; };
+    L("=== XCL COMPARE BATCH (standalone interpreter) ===");
+    L("TimestampFrequencyHz: "+std::to_string(g.tsFreq));
+    // Same 7-instruction loop prefix as gpu_scalar_loop_and_scc
+    std::vector<rdna2::Inst> prog;
+    auto mk=[&](rdna2::Op op,uint8_t dst,uint16_t src0f,uint8_t src1,int16_t simm=0){ rdna2::Inst i{}; i.op=op; i.dst=dst; i.src0_full=src0f; i.src0=(uint8_t)(src0f&0xFF); i.src1=src1; i.simm16=simm; prog.push_back(i); };
+    mk(rdna2::Op::S_MOV_B32,0,128,0);
+    mk(rdna2::Op::S_MOV_B32,1,138,0);
+    mk(rdna2::Op::S_ADD_U32,0,0,1);
+    mk(rdna2::Op::S_SUB_U32,1,1,129);
+    mk(rdna2::Op::S_CMP_LG_U32,0,1,128);
+    mk(rdna2::Op::S_CBRANCH_SCC1,0,0,0,-4);
+    mk(rdna2::Op::V_MOV_B32,1,0,0);
+    mk(rdna2::Op::S_ENDPGM,0,0,0);
+    rdna2::WaveState init{}; init.exec=0xFFFFFFFFFFFFFFFFull;
+    rdna2::WaveState cpu=init; std::vector<uint32_t> cpuMem(256,0);
+    auto rc=rdna2::runCpuReference(cpu,prog,cpuMem,100000);
+    bool cpuOk=(rc==rdna2::RefResult::Ok); bool cpuV1All55=true; for(int l=0;l<64;++l) if(rdna2::vgpr(cpu,l,1)!=55u) cpuV1All55=false;
+    L("CPU ref: rc="+std::to_string((int)rc)+" s0="+std::to_string(cpu.sgpr[0])+" v1_all_55="+(cpuV1All55?"1":"0"));
+    std::string hlsl=InterpreterHlsl(); std::string err; double dxMs=0; auto dxil=Compile(hlsl,L"interpreter.hlsl",dxMs,err);
+    if(!dxil){ L("DXC FAIL: "+err); return 1; }
+    D3D12_COMPUTE_PIPELINE_STATE_DESC pd{}; pd.pRootSignature=g.rsInterp.Get(); pd.CS={dxil->GetBufferPointer(),dxil->GetBufferSize()};
+    ComPtr<ID3D12PipelineState> pso; auto tps0=Clock::now(); Check(g.device->CreateComputePipelineState(&pd,IID_PPV_ARGS(&pso)),"PSO"); auto tps1=Clock::now(); double psoMs=Ms(tps0,tps1);
+    auto packed=PackProgram(prog); auto initS=MakeInitState(init); RunCfg cfg; cfg.maxSteps=100000; cfg.memWords=256;
+    // warmup
+    RunInterpBatch(g,pso.Get(),packed,initS,{},cfg,10);
+    std::ofstream csv(outDir+"/xcl_compare_batch/standalone_batch.csv", std::ios::binary);
+    csv<<"batch,trial,batch_gpu_ms,batch_wall_ms,per_dispatch_gpu_ms,status,s0,v1_all_55,ok\n";
+    std::ostringstream js; js<<"{\n  \"phase\":\"standalone_xcl_compare_batch\",\n  \"tsFreqHz\":"<<g.tsFreq<<",\n  \"dxcMs\":"<<dxMs<<",\n  \"psoMs\":"<<psoMs<<",\n  \"trials\":"<<trials<<",\n  \"cpuRef\":{\"ok\":"<<(cpuOk?"true":"false")<<",\"s0\":"<<cpu.sgpr[0]<<",\"v1All55\":"<<(cpuV1All55?"true":"false")<<"},\n  \"batches\":[\n";
+    int failures=0;
+    for(size_t bi=0;bi<batches.size();++bi){ int b=batches[bi];
+        std::vector<double> batchMs, perMs; int pass=0;
+        for(int t=0;t<trials;++t){
+            auto r=RunInterpBatch(g,pso.Get(),packed,initS,{},cfg,b);
+            bool ok=r.ok && r.status==1 && r.s0==55 && r.v1All55;
+            if(ok) pass++; else failures++;
+            double per=r.batchGpuMs/(double)b;
+            batchMs.push_back(r.batchGpuMs); perMs.push_back(per);
+            csv<<b<<","<<t<<","<<r.batchGpuMs<<","<<r.batchWallMs<<","<<per<<","<<r.status<<","<<r.s0<<","<<(r.v1All55?1:0)<<","<<(ok?1:0)<<"\n";
+        }
+        auto sb=Calc(batchMs); auto sp=Calc(perMs);
+        L("batch="+std::to_string(b)+" trials="+std::to_string(trials)+" pass="+std::to_string(pass)+"/"+std::to_string(trials)+" batchMedMs="+std::to_string(sb.median)+" perDispatchMedMs="+std::to_string(sp.median));
+        js<<"    {\"batch\":"<<b<<",\"pass\":"<<pass<<",\"batchGpuMsMedian\":"<<sb.median<<",\"batchGpuMsP95\":"<<sb.p95<<",\"batchGpuMsMin\":"<<sb.minv<<",\"batchGpuMsMax\":"<<sb.maxv<<",\"perDispatchGpuMsMedian\":"<<sp.median<<",\"perDispatchGpuMsP95\":"<<sp.p95<<",\"perDispatchGpuMsMin\":"<<sp.minv<<",\"perDispatchGpuMsMax\":"<<sp.maxv<<" }"<<(bi+1<batches.size()?",":"")<<"\n";
+    }
+    js<<"  ]\n}\n";
+    std::ofstream jf(outDir+"/xcl_compare_batch/standalone_batch.json", std::ios::binary); jf<<js.str();
+    L("Wrote "+outDir+"/xcl_compare_batch/standalone_batch.json");
+    return failures;
+}
